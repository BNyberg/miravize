{
  "name": "miravize",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:config": "node scripts/check-cloudflare-config.mjs",
    "check:artifacts": "node scripts/check-build-artifacts.mjs",
    "check:wrangler": "wrangler deploy --dry-run --no-autoconfig --env=\"\" --outdir .wrangler/dry-run",
    "check:build": "npm run check:config && tsc -b && npm run lint && vite build && npm run check:artifacts && npm run check:wrangler",
    "check:smoke": "node scripts/smoke-static.mjs && playwright test",
    "test:crypto": "tsc -p tsconfig.crypto.json --noEmit && node --experimental-strip-types --test src/lib/crypto/crypto.test.ts",
    "test:onboarding": "node --experimental-strip-types --test src/features/onboarding/onboarding.test.ts",
    "test:unit": "tsc -p tsconfig.vitest.json --noEmit && npm run test:crypto && npm run test:onboarding && vitest run && node --test scripts/cloudflare-rules.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "hash-wasm": "^4.13.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.6.4",
    "jspdf": "^4.2.1",
    "libsodium-wrappers": "^0.8.4",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
